# Demo/dev template — copy to .env. For production: set DEMO_MODE=false
# and replace SECRET_KEY with a strong random value (32+ chars).
DATABASE_URL=sqlite:///./evidencevault.db
SECRET_KEY=
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE_MB=25
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=300
LOCKOUT_SECONDS=600
